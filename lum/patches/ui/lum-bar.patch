+    constexpr float kHalfWidth = 6.0f;
+    SkPathBuilder path;
+    switch (button_type_) {
+      case VIEW_ID_MINIMIZE_BUTTON:
+        path.moveTo(c.x() - kHalfWidth, c.y() - 2.5f);
