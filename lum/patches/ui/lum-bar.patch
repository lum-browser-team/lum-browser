+      case VIEW_ID_MAXIMIZE_BUTTON:
+      case VIEW_ID_RESTORE_BUTTON:
+        color = SkColorSetRGB(0xF5, 0xC5, 0x42);
+        break;
+      default:
+        color = SkColorSetRGB(0xFF, 0x5F, 0x57);
+        break;
+    }
+    const double hover = GetState() == STATE_PRESSED
+                             ? 1.0
+                             : hover_animation().GetCurrentValue();
+    const int idle_alpha = GetWidget()->ShouldPaintAsActive() ? 0xD0 : 0x80;
+    color = SkColorSetA(color, static_cast<SkAlpha>(gfx::Tween::IntValueBetween(
