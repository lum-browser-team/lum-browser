+// Lum: the bar shows only Lum's controls. Everything else Chromium puts in the
+// toolbar (app menu, extensions, profile, side panel buttons...) is kept alive,
+// so features anchored to it keep working, but takes no space and draws nothing.
+void LumHideNonLumControls(ToolbarView* toolbar,
+                           const views::View* back,
+                           const views::View* forward) {
+  for (views::View* child : toolbar->children()) {
+    const bool lum_control = child == back || child == forward ||
+                             child == toolbar->reload_button() ||
+                             child == toolbar->location_bar_view();
+    if (!lum_control) {
+      // Zero-sized and fully transparent: some of these paint to their own
+      // layers, which a zero-sized parent does not clip. Not SetVisible(false):
+      // Chromium toggles their visibility itself, which would fight with us
+      // and re-layout forever.
+      child->SetProperty(views::kViewIgnoredByLayoutKey, true);
+      child->SetBoundsRect(gfx::Rect());
+      if (!child->layer()) {
+        child->SetPaintToLayer();
+      }
+      child->layer()->SetOpacity(0.0f);
+      child->SetCanProcessEventsWithinSubtree(false);
+    }
+  }
+}
+
