+        break;
+      case VIEW_ID_MAXIMIZE_BUTTON:
+      case VIEW_ID_RESTORE_BUTTON:
+        path.moveTo(c.x() - kHalfWidth, c.y() + 2.5f);
+        path.quadTo(c.x(), c.y() - 4.5f, c.x() + kHalfWidth, c.y() + 2.5f);
